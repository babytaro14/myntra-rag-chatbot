*.env
.env
kaggle-rag-chatbot.env
.streamlit/secrets.toml

# Python
__pycache__/
*.pyc
.venv/
venv/

# Raw data -- NOT shipped
data/raw/

# chroma_db IS shipped: a prebuilt 5k index so the deployed app loads instantly
# (rebuild-on-boot loops on Streamlit Cloud's free tier). Local full rebuilds
# with build_index.py simply overwrite it.

# Ship only products_clean.csv (the 5k subset); keep the full backup local-only
data/processed/*
!data/processed/products_clean.csv

# OS
.DS_Store
